{
  "name": "@tammy/desktop",
  "productName": "Tammy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "prepare:runtime": "node ../../scripts/prepare-electron-runtime.mjs",
    "prestart": "pnpm prepare:runtime",
    "start": "electron-vite dev -w",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prepackage": "pnpm prepare:runtime",
    "package": "pnpm build && electron-builder --config electron-builder.yml --dir --publish never",
    "package:mas:unsigned": "pnpm build && electron-builder --config electron-builder.yml --mac mas --arm64 --publish never",
    "pretest": "pnpm prepare:runtime",
    "test": "vitest run --maxWorkers=1",
    "pretest:watch": "pnpm prepare:runtime",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pree2e": "pnpm prepare:runtime",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@formepdf/core": "0.25.0",
    "@formepdf/react": "0.25.0",
    "@radix-ui/react-compose-refs": "1.1.3",
    "@radix-ui/react-slot": "1.3.0",
    "@tammy/connect-client": "workspace:*",
    "@tammy/invoices": "workspace:*",
    "@tammy/local-api": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-conveyor": "0.4.0",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "scheduler": "0.27.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14",
    "@tammy/reporting": "workspace:*"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "29.1.1",
    "shadcn": "4.13.1",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "csv-parse": "7.0.3",
    "pdfjs-dist": "6.4.299"
  }
}
