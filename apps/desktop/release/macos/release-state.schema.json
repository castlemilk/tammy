{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tammy-accounting.castlemilk.chatgpt.site/schemas/macos-release-state-v1.json",
  "title": "Tammy macOS release state and redacted evidence contract",
  "oneOf": [
    { "$ref": "#/$defs/releaseStateRecord" },
    { "$ref": "#/$defs/releaseAttestation" },
    { "$ref": "#/$defs/lifecycleEvent" }
  ],
  "$defs": {
    "readinessState": {
      "enum": [
        "NOT_READY",
        "REPOSITORY_READY",
        "CANDIDATE_READY",
        "PRE_UPLOAD_READY",
        "UPLOADED",
        "PRE_SUBMIT_READY"
      ]
    },
    "attestationKind": {
      "enum": [
        "company-controller",
        "seller-eligibility",
        "content-rights",
        "export-compliance",
        "pricing-availability",
        "privacy-answer",
        "age-rating",
        "processed-build",
        "metadata-assets-entered",
        "app-store-warning-review"
      ]
    },
    "lifecycleKind": {
      "enum": ["uploaded", "expired", "superseded", "submitted", "approved", "rejected"]
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "buildNumber": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "utcTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "redactedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}|(?:ghp|github_pat)_[A-Za-z0-9_]{16,}|AKIA[A-Z0-9]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(?:[pP][aA][sS][sS][wW][oO][rR][dD]|[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT])="
      }
    },
    "redactedReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}|(?:ghp|github_pat)_[A-Za-z0-9_]{16,}|AKIA[A-Z0-9]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(?:[pP][aA][sS][sS][wW][oO][rR][dD]|[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT])="
      },
      "oneOf": [
        {
          "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*OPERATOR_REQUIRED).+$"
        },
        {
          "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "owner", "remediation"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "owner": { "enum": ["repository", "candidate", "operator", "apple"] },
        "remediation": { "type": "string", "minLength": 1 }
      }
    },
    "releaseStateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "passed", "blockers"],
      "properties": {
        "state": { "$ref": "#/$defs/readinessState" },
        "passed": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } }
      }
    },
    "attestationBase": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "releaseVersion",
        "buildNumber",
        "accountablePerson",
        "confirmedAt",
        "evidenceReference",
        "outcome"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "$ref": "#/$defs/attestationKind" },
        "releaseVersion": { "$ref": "#/$defs/version" },
        "buildNumber": { "$ref": "#/$defs/buildNumber" },
        "accountablePerson": {
          "allOf": [
            { "$ref": "#/$defs/redactedText" },
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "not": { "pattern": "OPERATOR_REQUIRED" }
            }
          ]
        },
        "confirmedAt": { "$ref": "#/$defs/utcTime" },
        "evidenceReference": { "$ref": "#/$defs/redactedReference" },
        "outcome": { "type": "string" }
      }
    },
    "companyControllerAttestation": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/attestationBase" },
        {
          "properties": {
            "kind": { "const": "company-controller" },
            "outcome": { "const": "confirmed" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "contentRightsAttestation": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/attestationBase" },
        { "properties": { "kind": { "const": "content-rights" }, "outcome": { "const": "owned" } } }
      ],
      "unevaluatedProperties": false
    },
    "exportComplianceAttestation": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/attestationBase" },
        {
          "properties": {
            "kind": { "const": "export-compliance" },
            "outcome": { "enum": ["exempt", "non-exempt"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "pricingAvailabilityAttestation": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/attestationBase" },
        {
          "properties": {
            "kind": { "const": "pricing-availability" },
            "outcome": { "const": "confirmed" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "privacyAnswerAttestation": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/attestationBase" },
        {
          "properties": {
            "kind": { "const": "privacy-answer" },
            "outcome": { "const": "no-data-collected-no-tracking" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ageRatingAttestation": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/attestationBase" },
        { "properties": { "kind": { "const": "age-rating" }, "outcome": { "const": "completed" } } }
      ],
      "unevaluatedProperties": false
    },
    "processedBuildAttestation": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/attestationBase" },
        {
          "properties": {
            "kind": { "const": "processed-build" },
            "outcome": { "const": "selected" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "metadataAssetsAttestation": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/attestationBase" },
        {
          "properties": {
            "kind": { "const": "metadata-assets-entered" },
            "outcome": { "const": "entered" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "warningReviewAttestation": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/attestationBase" },
        {
          "properties": {
            "kind": { "const": "app-store-warning-review" },
            "outcome": { "enum": ["clear", "resolved"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sellerBase": {
      "type": "object",
      "required": [
        "eligibilityBranch",
        "teamId",
        "sellerName",
        "accountHolder",
        "activeAgreements",
        "appId",
        "appleDeveloperIdentifierId",
        "appStoreConnectId",
        "applicationGroup",
        "helperIdentifiers",
        "certificateClasses",
        "profilesReissued"
      ],
      "properties": {
        "kind": { "const": "seller-eligibility" },
        "outcome": { "const": "eligible" },
        "eligibilityBranch": { "enum": ["company-organization", "written-apple-exception"] },
        "teamId": { "type": "string", "pattern": "^[A-Z0-9]{10}$" },
        "sellerName": {
          "allOf": [
            { "$ref": "#/$defs/redactedText" },
            { "type": "string", "minLength": 2, "maxLength": 100 }
          ]
        },
        "accountHolder": {
          "allOf": [
            { "$ref": "#/$defs/redactedText" },
            { "type": "string", "minLength": 2, "maxLength": 100 }
          ]
        },
        "activeAgreements": { "const": true },
        "appId": { "const": "com.tammy.desktop" },
        "appleDeveloperIdentifierId": { "$ref": "#/$defs/redactedText" },
        "appStoreConnectId": { "type": "string", "pattern": "^[1-9][0-9]{5,19}$" },
        "applicationGroup": { "$ref": "#/$defs/redactedText" },
        "helperIdentifiers": {
          "const": [
            "com.tammy.desktop.helper",
            "com.tammy.desktop.helper.GPU",
            "com.tammy.desktop.helper.Plugin",
            "com.tammy.desktop.helper.Renderer"
          ]
        },
        "certificateClasses": {
          "const": ["Apple Development", "Apple Distribution", "Mac Installer Distribution"]
        },
        "profilesReissued": { "const": true }
      }
    },
    "sellerCompanyBranch": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/attestationBase" },
        { "$ref": "#/$defs/sellerBase" },
        {
          "properties": {
            "eligibilityBranch": { "const": "company-organization" },
            "sellerName": { "const": "Gamma Systems Pty Ltd" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sellerWrittenExceptionBranch": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/attestationBase" },
        { "$ref": "#/$defs/sellerBase" },
        {
          "required": ["writtenAppleExceptionReference"],
          "properties": {
            "eligibilityBranch": { "const": "written-apple-exception" },
            "teamId": { "const": "WFTX6CN23F" },
            "sellerName": { "const": "Ben Ebsworth" },
            "accountHolder": { "const": "Ben Ebsworth" },
            "appleDeveloperIdentifierId": { "const": "WFTX6CN23F.com.tammy.desktop" },
            "applicationGroup": { "const": "WFTX6CN23F.com.tammy.desktop" },
            "writtenAppleExceptionReference": {
              "allOf": [
                { "$ref": "#/$defs/redactedReference" },
                {
                  "type": "string",
                  "pattern": "written[-_ ](?:apple[-_ ])?exception",
                  "not": { "pattern": "publisher-controller" }
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sellerEligibilityAttestation": {
      "oneOf": [
        { "$ref": "#/$defs/sellerCompanyBranch" },
        { "$ref": "#/$defs/sellerWrittenExceptionBranch" }
      ]
    },
    "releaseAttestation": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/companyControllerAttestation" },
        { "$ref": "#/$defs/sellerEligibilityAttestation" },
        { "$ref": "#/$defs/contentRightsAttestation" },
        { "$ref": "#/$defs/exportComplianceAttestation" },
        { "$ref": "#/$defs/pricingAvailabilityAttestation" },
        { "$ref": "#/$defs/privacyAnswerAttestation" },
        { "$ref": "#/$defs/ageRatingAttestation" },
        { "$ref": "#/$defs/processedBuildAttestation" },
        { "$ref": "#/$defs/metadataAssetsAttestation" },
        { "$ref": "#/$defs/warningReviewAttestation" }
      ],
      "unevaluatedProperties": false
    },
    "eventBase": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "releaseVersion",
        "buildNumber",
        "operator",
        "occurredAt"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "$ref": "#/$defs/lifecycleKind" },
        "releaseVersion": { "$ref": "#/$defs/version" },
        "buildNumber": { "$ref": "#/$defs/buildNumber" },
        "operator": {
          "allOf": [
            { "$ref": "#/$defs/redactedText" },
            { "type": "string", "minLength": 2, "maxLength": 100 }
          ]
        },
        "occurredAt": { "$ref": "#/$defs/utcTime" }
      }
    },
    "uploadedEvent": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": [
            "productSourceCommit",
            "productSourceTree",
            "packageSha256",
            "appStoreConnectBuildId"
          ],
          "properties": {
            "kind": { "const": "uploaded" },
            "productSourceCommit": { "$ref": "#/$defs/sha40" },
            "productSourceTree": { "$ref": "#/$defs/sha40" },
            "packageSha256": { "$ref": "#/$defs/sha256" },
            "appStoreConnectBuildId": {
              "allOf": [
                { "$ref": "#/$defs/redactedText" },
                { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "expiredEvent": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["reason"],
          "dependentRequired": {
            "sourceReference": ["packageSha256"],
            "packageSha256": ["sourceReference"]
          },
          "properties": {
            "kind": { "const": "expired" },
            "reason": { "enum": ["certificate-expired", "profile-expired", "candidate-timeout"] },
            "sourceReference": { "$ref": "#/$defs/redactedReference" },
            "packageSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "supersededEvent": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "dependentRequired": {
            "replacementVersion": ["replacementBuildNumber"],
            "replacementBuildNumber": ["replacementVersion"]
          },
          "properties": {
            "kind": { "const": "superseded" },
            "replacementVersion": { "$ref": "#/$defs/version" },
            "replacementBuildNumber": { "$ref": "#/$defs/buildNumber" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "submittedEvent": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["appStoreSubmissionReference"],
          "properties": {
            "kind": { "const": "submitted" },
            "appStoreSubmissionReference": { "$ref": "#/$defs/redactedReference" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "approvedEvent": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["reviewReference", "submittedEventPath"],
          "properties": {
            "kind": { "const": "approved" },
            "reviewReference": { "$ref": "#/$defs/redactedReference" },
            "submittedEventPath": { "$ref": "#/$defs/redactedReference" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "rejectedEvent": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["reviewReference", "submittedEventPath"],
          "properties": {
            "kind": { "const": "rejected" },
            "reviewReference": { "$ref": "#/$defs/redactedReference" },
            "submittedEventPath": { "$ref": "#/$defs/redactedReference" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "lifecycleEvent": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/uploadedEvent" },
        { "$ref": "#/$defs/expiredEvent" },
        { "$ref": "#/$defs/supersededEvent" },
        { "$ref": "#/$defs/submittedEvent" },
        { "$ref": "#/$defs/approvedEvent" },
        { "$ref": "#/$defs/rejectedEvent" }
      ],
      "unevaluatedProperties": false
    }
  },
  "$comment": "scripts/macos-release-state.mjs is the executable strict validator. Dynamic company-team prefix equality is enforced there because JSON Schema cannot compare sibling string values."
}
