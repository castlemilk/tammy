{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Keep dependency declarations strict for the desktop application bundle.
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.electron-vite.config.ts"
  ]
}
